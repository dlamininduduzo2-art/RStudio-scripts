# 12. PHYLUM-LEVEL RELATIVE ABUNDANCE
# ==============================================================================

phylum <- dat %>%

  group_by(
    Sample,
    Phylum = Phylum_plot
  ) %>%

  summarise(

    Count = sum(
      Count,
      na.rm = TRUE
    ),

    .groups = "drop"
  ) %>%

  group_by(Sample) %>%

  mutate(

    Relative_abundance =
      Count /
      sum(Count) *
      100
  ) %>%

  ungroup()


# Top phyla

top_phyla <- phylum %>%

  group_by(Phylum) %>%

  summarise(

    Mean_abundance =
      mean(
        Relative_abundance,
        na.rm = TRUE
      ),

    .groups = "drop"
  ) %>%

  arrange(
    desc(Mean_abundance)
  ) %>%

  slice_head(
    n = TOP_PHYLA
  ) %>%

  pull(Phylum)


phylum_collapsed <- phylum %>%

  mutate(

    Phylum_plot = if_else(

      Phylum %in% top_phyla,

      Phylum,

      "Other"
    )
  ) %>%

  group_by(
    Sample,
    Phylum_plot
  ) %>%

  summarise(

    Relative_abundance =
      sum(
        Relative_abundance,
        na.rm = TRUE
      ),

    .groups = "drop"
  )


# ==============================================================================
# 13. GUARANTEE EVERY SAMPLE EXISTS IN PHYLUM PLOT
# ==============================================================================

all_phylum_categories <- unique(
  phylum_collapsed$Phylum_plot
)


phylum_grid <- expand_grid(

  Sample = factor(
    sample_order,
    levels = sample_order
  ),

  Phylum_plot = all_phylum_categories
)


phylum_plot_data <- phylum_grid %>%

  left_join(
    phylum_collapsed,
    by = c(
      "Sample",
      "Phylum_plot"
    )
  ) %>%

  mutate(

    Relative_abundance =
      replace_na(
        Relative_abundance,
        0
      )
  ) %>%

  group_by(Sample) %>%

  mutate(

    sample_total =
      sum(
        Relative_abundance,
        na.rm = TRUE
      ),

    Relative_abundance =
      if_else(
        sample_total > 0,
        Relative_abundance /
          sample_total *
          100,
        0
      )
  ) %>%

  ungroup() %>%

  select(
    -sample_total
  )


