# ==============================================================================
# 23. TOP-20 GENUS HEATMAP
#
# Unclassified taxa are excluded here because the objective is to
# display identified genera.
# ==============================================================================

heatmap_top <- genus %>%

  filter(
    Genus != "Unclassified"
  ) %>%

  group_by(Genus) %>%

  summarise(

    Mean_abundance =
      mean(
        Relative_abundance,
        na.rm = TRUE
      ),

    .groups = "drop"
  ) %>%

  arrange(
    desc(Mean_abundance)
  ) %>%

  slice_head(
    n = TOP_HEATMAP_GENERA
  ) %>%

  pull(Genus)


heatmap_grid <- expand_grid(

  Sample = factor(
    sample_order,
    levels = sample_order
  ),

  Genus = heatmap_top
)


heatmap_data <- genus %>%

  filter(
    Genus %in% heatmap_top
  ) %>%

  select(
    Sample,
    Genus,
    Relative_abundance
  )


heatmap_data <- heatmap_grid %>%

  left_join(

    heatmap_data,

    by = c(
      "Sample",
      "Genus"
    )
  ) %>%

  mutate(

    Relative_abundance =
      replace_na(
        Relative_abundance,
        0
      ),

    Log_abundance =
      log10(
        Relative_abundance +
          0.01
      ),

    Genus = factor(
      Genus,
      levels = rev(
        heatmap_top
      )
    )
  )


# ==============================================================================
# 24. HEATMAP
# ==============================================================================

p_heatmap <- ggplot(

