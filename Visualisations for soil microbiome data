# ==============================================================================
# 26. PREPARE TRUE GENUS-LEVEL DATA FOR NETWORK
# ==============================================================================

network_data <- dat


if (!NETWORK_INCLUDE_UNCLASSIFIED) {

  network_data <- network_data %>%

    filter(
      !is.na(Genus)
    )
}


# Keep genuine genus assignments only

network_genus <- network_data %>%

  filter(
    !is.na(Genus)
  ) %>%

  group_by(
    Sample,
    Genus
  ) %>%

  summarise(

    Count =
      sum(
        Count,
        na.rm = TRUE
      ),

    .groups = "drop"
  )


# ==============================================================================
# 27. NETWORK PREVALENCE FILTER
# ==============================================================================

n_samples <- length(
  unique(
    network_genus$Sample
  )
)


prevalence <- network_genus %>%

  group_by(Genus) %>%

  summarise(

    Present =
      sum(
        Count > 0
      ),

    Prevalence =
      Present /
      n_samples,

    .groups = "drop"
  )


keep_genera <- prevalence %>%

  filter(
    Prevalence >=
      PREVALENCE_THRESHOLD
  ) %>%

  pull(Genus)


network_filtered <- network_genus %>%

  filter(
    Genus %in% keep_genera
  )


cat("\n========================================\n")
cat("NETWORK FILTERING\n")
cat("========================================\n")

cat(
  "Samples:",
  n_samples,
  "\n"
)

cat(
  "Genera retained after prevalence filtering:",
  length(
    unique(
      network_filtered$Genus
    )
  ),
  "\n"
)


write.csv(

  prevalence,

  file.path(
    OUTPUT_DIR,
    "network_genus_prevalence.csv"
  ),

  row.names = FALSE
)


# ==============================================================================
# 28. SAMPLE x GENUS COUNT MATRIX
# ==============================================================================

network_matrix_df <- network_filtered %>%

  pivot_wider(

    names_from = Genus,

    values_from = Count,

    values_fill = 0
  )


network_sample_names <-
  network_matrix_df$Sample


network_matrix <- network_matrix_df %>%

  select(
    -Sample
  ) %>%

  as.matrix()


rownames(
  network_matrix
) <- network_sample_names


# ==============================================================================
# 29. CLR TRANSFORMATION
# ==============================================================================

network_pc <-
  network_matrix +
  PSEUDOCOUNT


clr_matrix <- t(

  apply(

    network_pc,

    1,

    function(x) {

      log(x) -
        mean(
          log(x)
        )
    }
  )
)


# ==============================================================================
# 30. PAIRWISE SPEARMAN ASSOCIATIONS
# ==============================================================================

taxa_names <- colnames(
  clr_matrix
)


taxon_pairs <- combn(

  taxa_names,

  2,

  simplify = FALSE
)


safe_spearman <- function(pair) {

  x <- clr_matrix[, pair[1]]

  y <- clr_matrix[, pair[2]]

  # Avoid constant vectors

  if (
    sd(x) == 0 ||
      sd(y) == 0
  ) {

    return(

      tibble(

        Taxon1 = pair[1],

        Taxon2 = pair[2],

        rho = NA_real_,

        p = NA_real_
      )
    )
  }


  test <- suppressWarnings(

    cor.test(

      x,

      y,

      method = "spearman",

      exact = FALSE
    )
  )


  tibble(

    Taxon1 = pair[1],

    Taxon2 = pair[2],

    rho =
      unname(
        test$estimate
      ),

    p =
      test$p.value
  )
}


edge_tests <- map_dfr(

  taxon_pairs,

  safe_spearman
)


# ==============================================================================
# 31. MULTIPLE-TEST CORRECTION
# ==============================================================================

edge_tests <- edge_tests %>%

  mutate(

    p_adj =
      p.adjust(
        p,
        method = "BH"
      )
  )


# ==============================================================================
# 32. RETAIN NETWORK EDGES
# ==============================================================================

network_edges <- edge_tests %>%

  filter(

    !is.na(rho),

    !is.na(p_adj),

    abs(rho) >=
      CORRELATION_THRESHOLD,

    p_adj <
      FDR_THRESHOLD
  ) %>%

  mutate(

    Association =
      if_else(
        rho > 0,
        "Positive",
        "Negative"
      ),

    Weight =
      abs(rho)
  )


cat(
